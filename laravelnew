#!/usr/bin/env bash
set -euo pipefail

VERSION="0.4.0"

usage() {
  echo "Usage: laravelnew <app-name> [--here] [--using=<starter-kit>] [--start] [--version]"
  echo
  echo "Options:"
  echo "  --here                 Create the app, then copy it into the current directory"
  echo "  --using=<starter-kit>  Forwarded to: laravel new <app-name> --using=<starter-kit>"
  echo "  --start                Start Sail and the frontend dev server after creation"
  echo "  --version              Show laravelnew version"
  echo "  -h, --help             Show this help"
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  echo "$VERSION"
  exit 0
fi

APP_NAME=""
HERE="false"
START="false"
USING=""

# Parse args (order-independent)
for arg in "$@"; do
  case "$arg" in
    --here)
      HERE="true"
      ;;
    --start)
      START="true"
      ;;
    --using=*)
      USING="${arg#--using=}"
      ;;
    --version|-v)
      echo "$VERSION"
      exit 0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $arg"
      usage
      exit 1
      ;;
    *)
      if [[ -z "$APP_NAME" ]]; then
        APP_NAME="$arg"
      else
        echo "Unexpected argument: $arg"
        usage
        exit 1
      fi
      ;;
  esac
done

if [[ -z "$APP_NAME" ]]; then
  usage
  exit 1
fi

# Keep app names safe and predictable for paths and container scripting.
if [[ ! "$APP_NAME" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid app name: $APP_NAME"
  echo "Allowed characters: letters, numbers, dot, dash, underscore."
  exit 1
fi

# Fast-fail if target already exists (both default and --here flow create this folder first).
if [[ -e "$APP_NAME" ]]; then
  echo "Path already exists: $APP_NAME"
  exit 1
fi

start_project() {
  local project_dir="$1"

  (
    cd "$project_dir"
    ./vendor/bin/sail up -d
    ./vendor/bin/sail npm install
    ./vendor/bin/sail npm run dev
  )
}

prompt_start_project() {
  local project_dir=""
  local project_label=""
  local ans=""

  if [[ "$HERE" == "true" && ! -e "$APP_NAME" && -x "./vendor/bin/sail" ]]; then
    project_dir="."
    project_label=""
  elif [[ -x "$APP_NAME/vendor/bin/sail" ]]; then
    project_dir="$APP_NAME"
    project_label="cd $APP_NAME && "
  else
    return
  fi

  if [[ "$START" == "true" ]]; then
    start_project "$project_dir"
    return
  fi

  if [[ ! -t 0 ]]; then
    return
  fi

  echo
  printf "Start Sail and the frontend dev server now? [y/N]: "
  read -r ans || ans=""

  case "$ans" in
    y|Y|yes|YES)
      start_project "$project_dir"
      ;;
    *)
      echo "==> Done. Next (on host):   ${project_label}./vendor/bin/sail up"
      echo "    After Sail is running:  ${project_label}./vendor/bin/sail npm install && ./vendor/bin/sail npm run dev"
      ;;
  esac
}

docker run --rm -it \
  --pull=always \
  -u "$(id -u):$(id -g)" \
  -v "$(pwd):/app" \
  -w /app \
  -e COMPOSER_HOME=/tmp/composer \
  -e APP_NAME="$APP_NAME" \
  -e HERE="$HERE" \
  -e USING="$USING" \
  composer:latest \
  bash -lc '
    set -euo pipefail

    export PATH="$COMPOSER_HOME/vendor/bin:$PATH"

    boost_install() {
      local ans=""

      echo
      printf "Install Laravel Boost? [Y/n]: "
      read -r ans || ans=""

      case "$ans" in
        ""|y|Y|yes|YES)
          composer require laravel/boost --dev
          php artisan boost:install
          ;;
        *)
          echo "==> Skipping Laravel Boost installation."
          ;;
      esac
    }

    echo "==> Installing Laravel installer (container-only)"
    composer global require laravel/installer

    echo "==> Creating Laravel project: $APP_NAME"
    no_node_arg=()
    if laravel new --help 2>/dev/null | grep -q -- "--no-node"; then
      no_node_arg=(--no-node)
    else
      echo "==> Warning: installed Laravel installer does not support --no-node yet; continuing without it."
      echo "    If Laravel asks to run npm install and npm run build, answer no. Sail can run npm after project creation."
    fi
    if [ -n "$USING" ]; then
      laravel new "$APP_NAME" --using="$USING" "${no_node_arg[@]}" --no-boost
    else
      laravel new "$APP_NAME" "${no_node_arg[@]}" --no-boost
    fi

    if [ "$HERE" = "true" ]; then
      echo
      echo "==> --here will copy $APP_NAME into the current directory."
      echo "    WARNING: This may overwrite existing files."
      printf "Proceed with copying into the current directory? [Y/n]: "
      read -r ans

      case "$ans" in
        ""|y|Y|yes|YES)
          echo "==> Copying project into current directory..."
          cp -R "/app/$APP_NAME"/. /app/
          echo "==> Removing temporary directory: $APP_NAME"
          rm -rf "/app/$APP_NAME"

          echo "==> Installing Sail"
          cd /app
          php artisan sail:install
          boost_install
          exit 0
          ;;
        *)
          echo "==> Skipping copy. Continuing as if --here was not used."
          ;;
      esac
    fi

    echo "==> Installing Sail"
    cd "/app/$APP_NAME"
    php artisan sail:install
    boost_install
  '

prompt_start_project
